  "description": "Clinic Booking API + web page (Koya Cohort 4 — Task BUILD-1). Next.js 16 App Router, TypeScript, Prisma.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
