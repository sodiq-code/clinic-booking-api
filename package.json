    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "^16.1.3",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1"
  }
