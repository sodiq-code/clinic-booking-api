    "db:push:local": "prisma db push --schema=prisma/schema.local.prisma --accept-data-loss",
    "db:generate:local": "prisma generate --schema=prisma/schema.local.prisma",
    "seed": "bun run scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "next": "^16.1.3",
