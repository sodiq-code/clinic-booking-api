# ---- Production (Postgres on Vercel) ----
# Used by prisma/schema.prisma. Set this to your Vercel Postgres connection string.
DATABASE_URL="postgresql://user:password@host:5432/clinic_booking?sslmode=require"

# API key checked against the X-API-Key header on every request (Level 2 auth).
API_KEY="change-me-to-a-long-random-secret"

# ---- Local dev/testing (SQLite) ----
# For local testing we use prisma/schema.local.prisma (provider sqlite).
# The path is resolved by Prisma relative to the schema file, so "file:./dev.db"
# lands at prisma/dev.db. Copy this file to `.env` and adjust as needed.
# DATABASE_URL="file:./dev.db"
