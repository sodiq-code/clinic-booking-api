// Local dev / testing schema — SQLite. Model definitions are IDENTICAL to
// schema.prisma; only the datasource provider + url differ.
// Generate & push with: bun run db:generate:local  &&  bun run db:push:local
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Hardcoded (not env()) so the local client ignores any DATABASE_URL that
  // may already be exported in the host shell. Prisma resolves SQLite `file:`
  // paths relative to this schema file -> prisma/dev.db.
  //
  // connection_limit=1: SQLite only supports a single writer. Serializing all
  //   queries through one connection avoids cross-connection write-lock
  //   contention (which otherwise thrashes under concurrent writes and exceeds
  //   Prisma's socket timeout -> P1008). Reads/writes still complete in ms
  //   because each statement holds the lock for microseconds.
  // socket_timeout=30000: generous per-query ceiling so a briefly-contended
  //   statement waits (busy_timeout) instead of erroring.
  // For production (Postgres) see prisma/schema.prisma which uses env("DATABASE_URL").
  url      = "file:./dev.db?connection_limit=1&socket_timeout=30000"
}

model Slot {
  id              String    @id
  provider        String
  start           DateTime
  end             DateTime
  bookedBookingId String?

  @@index([provider])
  @@index([start])
}

model Booking {
  id             String   @id @default(cuid())
  slotId         String
  name           String
  email          String
  status         String
  createdAt      DateTime @default(now())

  idempotencyKey String?
  bodyHash       String?

  @@index([email, createdAt])
  @@index([email])
  @@index([slotId])
}

model IdempotencyRecord {
  key          String   @id
  bodyHash     String
  statusCode   Int
  responseBody String
  bookingId    String?
  createdAt    DateTime @default(now())
}

model RateLimitAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
